{
  "dashboard": {
    "title": "Kawasan Broker Monitoring",
    "tags": ["kawasan", "kafka", "broker"],
    "timezone": "browser",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "panels": [
      {
        "title": "Broker Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"kawasan-broker\"}",
            "legendFormat": "Broker {{instance}}"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "UP", "color": "green"},
              {"type": "value", "value": "0", "text": "DOWN", "color": "red"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "title": "Uptime",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "kawasan_broker_uptime_seconds",
            "legendFormat": "{{instance}}"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "kawasan_active_connections",
            "legendFormat": "{{instance}}"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "title": "Topics & Partitions",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "kawasan_topics",
            "legendFormat": "Topics"
          },
          {
            "expr": "kawasan_partitions",
            "legendFormat": "Partitions"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "title": "Message Throughput (Messages/sec)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(kawasan_messages_produced_total[1m])",
            "legendFormat": "Produced - {{instance}}"
          },
          {
            "expr": "rate(kawasan_messages_consumed_total[1m])",
            "legendFormat": "Consumed - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Messages/sec"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "title": "Network Throughput (Bytes/sec)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "rate(kawasan_bytes_in_total[1m])",
            "legendFormat": "Bytes In - {{instance}}"
          },
          {
            "expr": "rate(kawasan_bytes_out_total[1m])",
            "legendFormat": "Bytes Out - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "Bytes/sec"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "title": "Produce Latency (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(kawasan_produce_latency_ms_bucket[5m]))",
            "legendFormat": "P50 - {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(kawasan_produce_latency_ms_bucket[5m]))",
            "legendFormat": "P95 - {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, rate(kawasan_produce_latency_ms_bucket[5m]))",
            "legendFormat": "P99 - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "Latency"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [1000], "type": "gt"},
              "query": {"params": ["C", "5m", "now"]},
              "type": "query"
            }
          ],
          "name": "High Produce Latency"
        }
      },
      {
        "title": "Fetch Latency (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(kawasan_fetch_latency_ms_bucket[5m]))",
            "legendFormat": "P50 - {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(kawasan_fetch_latency_ms_bucket[5m]))",
            "legendFormat": "P95 - {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, rate(kawasan_fetch_latency_ms_bucket[5m]))",
            "legendFormat": "P99 - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "Latency"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "title": "Requests by API (req/sec)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(kawasan_requests_total[1m])",
            "legendFormat": "{{api}} - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Requests/sec"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "title": "Request Errors by API (errors/sec)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "rate(kawasan_request_errors_total[1m])",
            "legendFormat": "{{api}} - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Errors/sec"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        },
        "seriesOverrides": [
          {"alias": "/.*/", "color": "red"}
        ]
      },
      {
        "title": "Disk Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "kawasan_disk_usage_bytes",
            "legendFormat": "{{instance}}"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Disk Usage"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [85899345920], "type": "gt"},
              "query": {"params": ["A", "5m", "now"]},
              "type": "query"
            }
          ],
          "name": "High Disk Usage"
        }
      },
      {
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "kawasan_memory_usage_bytes",
            "legendFormat": "{{instance}}"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Memory Usage"},
          {"format": "short"}
        ],
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "title": "Consumer Groups",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "kawasan_consumer_groups",
            "legendFormat": "{{instance}}"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "title": "Request Rate Trend",
        "type": "graph",
        "gridPos": {"h": 8, "w": 18, "x": 6, "y": 36},
        "targets": [
          {
            "expr": "sum(rate(kawasan_requests_total[5m])) by (instance)",
            "legendFormat": "Total Requests - {{instance}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Requests/sec"},
          {"format": "short"}
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "refresh": "30s",
    "schemaVersion": 38,
    "version": 1
  }
}
